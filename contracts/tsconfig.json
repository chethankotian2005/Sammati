{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "noEmit": false,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "mocha", "chai"]
