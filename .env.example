# Copy to .env. Every value has a working default, so this file is optional.
# This file is for the LOCAL stack. A hosted deployment (NODE_ENV=production) needs the variables of docs/trd.md §10.2,
# set in the host's dashboard, never here: it refuses to start with a missing secret, a published default key, an
# http:// public URL or a wildcard CORS origin (docs/deploy-guide.md).

# --- Core (trd.md §10) ---
PORT=4000
# Development only: enables the CLI scripts `pnpm dev:reset` and `pnpm dev:tamper` (nothing else). Core refuses to start
# with DEV_TOOLS=true beside NODE_ENV=production.
# DEV_TOOLS=true
# What the wallet is told in the QR code. On stage use the laptop's hotspot IP, e.g. http://192.168.43.10:4000
# Leave it unset: `pnpm demo:up` detects the laptop's LAN address and prints it. Set it only to override
# (e.g. http://192.168.43.10:4000), because `localhost` in a QR code is the phone itself.
# PUBLIC_CORE_URL=
# Proof links in API responses. Leave empty to follow the deployment (Polygon Amoy has an explorer, the local chain none).
CHAIN_EXPLORER_URL=

# --- Real Core (not used in stub mode) ---
CHAIN_RPC=http://127.0.0.1:8545
CHAIN_ID=31337
# Which entry of shared/deployments.json to use.
CHAIN_NETWORK=localhost
# QR codes stop working after this many seconds.
REQUEST_TTL_SECONDS=1800
# Hardhat public test keys; never use these on a real network.
# Relayer = keccak256("sammati-demo-relayer"); the seed funds it. Admin = Hardhat account #0.
RELAYER_KEY=0xfbe32bfa0c2ff2102e9a5f0cc05b7d469749f75ee21bdca151642f85525b2ecf
ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DB_PATH=./data/sammati.sqlite
# Hosted RPC friendliness (trd.md §10.7): how often Core reads new blocks and polls a transaction's receipt, the widest
# eth_getLogs range, the longest back-off after RPC failures, and the fee policy (Amoy needs a priority fee of 25 gwei or more,
# which is built in; set these only to override).
# INDEXER_INTERVAL_MS=1000
# RECEIPT_POLL_MS=250
# LOG_CHUNK_BLOCKS=2000
# RPC_BACKOFF_MAX_MS=60000
# GAS_PRIORITY_FEE_GWEI=
# GAS_MAX_FEE_GWEI=
# GAS_LIMIT_MULTIPLIER=1.2
# Production only: the browser origins allowed to call Core and the Processor (comma separated, exact, no trailing slash).
# CORS_ORIGINS=https://your-site.vercel.app

# --- Deploying to Polygon Amoy: `pnpm deploy:amoy` ---
# A wallet funded with Amoy test MATIC (from a faucet). Never commit this file with a real key in it.
DEPLOYER_KEY=
# Optional; defaults to Polygon's public endpoint.
AMOY_RPC_URL=

# --- Company backends ---
CORE_URL=http://localhost:4000
# FIDUCIARY_KEY=  (reserved: anchor signing, not used yet)

# --- Web (Vite) ---
VITE_CORE_URL=http://localhost:4000

# --- Sammati Processor: confidential processing (trd.md §6.7, §10) ---
# Where the wallet finds the Processor. Leave unset: `pnpm demo:up` uses the laptop's LAN address on port 4200.
# PROCESSOR_PUBLIC_URL=
PROCESSOR_PORT=4200
# The Processor's X25519 private key (0x + 64 hex). Unset: generated at start and lost on restart (the default:
# stored ciphertext then answers CIPHERTEXT_INVALID until the wallet sends again). In production it is REQUIRED and is
# never generated: back it up outside the host. Never commit a real one.
# PROCESSOR_KEY=
# Where the vault (ciphertext only) lives. Hosted: a persistent disk, e.g. /var/data/processor.sqlite.
# VAULT_PATH=./data/processor.sqlite
# Shared secret between the Processor and Core for the events it reports (a disclosed default; change it anywhere but a local machine).
PROCESSOR_EVENT_KEY=local-processor-events
# Seconds between the Processor's checks that stored data still has consent (expiry needs it), in ms:
PROCESSOR_SWEEP_MS=30000

# --- Company onboarding (trd.md §6.2a, §6.12) ---
# The code the regulator types into Auditor > Registrations: a disclosed demo secret, not an identity system.
REGULATOR_KEY=demo-regulator-key
# The registry's admin, who registers new companies. Unset: Hardhat account #0 (the deploy script's admin).
# ADMIN_KEY=
# Test ether a newly approved company's account is topped up to (its processors get a tenth).
REGISTRATION_FUNDING_ETH=1
# Applications per client address per hour, and applications allowed to wait for the regulator.
REGISTRATIONS_PER_HOUR=5
MAX_PENDING_APPLICATIONS=50
# Calls per minute one company's API key may make.
GATEWAY_RATE_PER_MINUTE=600
# Customers every sandbox company may ask, besides the regulator's own list (comma-separated addresses).
# SANDBOX_TEST_PRINCIPALS=
# For the sample app (docs/integration.md §4): your fiduciary address, API key and a purpose code.
# FIDUCIARY=
# SAMMATI_API_KEY=
# PURPOSE=
