# Copy to .env. Every value has a working default for stub mode, so this file is optional today.

# --- Core (trd.md §10) ---
PORT=4000
# Serve fixtures with in-memory state, no chain. Set false only once the real Core exists.
STUB_MODE=true
# Enables /v1/demo/* (tamper, reset, fire).
DEMO_MODE=true
# What the wallet is told in the QR code. On stage use the laptop's hotspot IP, e.g. http://192.168.43.10:4000
CORE_PUBLIC_URL=http://localhost:4000
CHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# --- Real Core (not used in stub mode) ---
CHAIN_RPC=http://127.0.0.1:8545
CHAIN_ID=31337
# Hardhat public test keys; never use these on a real network.
RELAYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DB_PATH=./data/sammati.sqlite

# --- Company backends ---
CORE_URL=http://localhost:4000
# FIDUCIARY_KEY=  (reserved: anchor signing, not used yet)

# --- Web (Vite) ---
VITE_CORE_URL=http://localhost:4000
