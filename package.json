{
  "name": "sammati",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo:up": "node scripts/demo-up.mjs",
    "deploy:local": "pnpm --filter @sammati/contracts run deploy:local",
    "deploy:amoy": "pnpm --filter @sammati/contracts run deploy:amoy",
    "seed": "pnpm --filter @sammati/contracts run seed:local",
    "e2e": "pnpm --filter @sammati/core run e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:tamper": "pnpm --filter @sammati/core dev:tamper"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "concurrently": "9.1.0",
    "eslint": "9.17.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1"
  }
}
