{
  "name": "@sammati/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:remote": "tsx scripts/e2e-remote.ts",
    "sample:company": "tsx examples/quickstart.ts",
    "pretest": "pnpm --filter @sammati/contracts compile",
