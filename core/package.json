  },
  "dependencies": {
    "@sammati/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "ethers": "6.13.4",
    "express": "4.21.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@sammati/gateway": "workspace:^",
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/ws": "8.5.13",
    "hardhat": "2.22.17",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "@sammati/test-fixtures": "workspace:*"
  }
